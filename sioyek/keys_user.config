# keys_user.config

# This config file enables full Vim-style keybindings for PDF navigation in Sioyek.
# It overrides defaults to use hjkl for movement, gg/G for document start/end, etc.
# Place this in your Sioyek user config directory (use :keys_user in Sioyek to open and edit).

# Basic movement (Vim hjkl)
move_left h
move_down j
move_up k
move_right l

# Document navigation (gg/G like Vim file top/bottom, <num>gg for specific page via prompt)
goto_begining gg
goto_end G

# Screen scrolling (Ctrl-u/d like Vim half-page up/down)
screen_up <C-u>
screen_down <C-d>

# Page turning (space/Shift-space remains default, but add Vim-like if desired)
# next_page space
# previous_page <S-space>

# Search ( / n N like Vim)
search /
next_item n
previous_item N

# Zoom (z Z, but z is often for fold in Vim; adjust if needed)
zoom_in z
zoom_out Z

# Rotation (r R like Vim repeat/redo, but for clockwise/counter)
rotate_clockwise r
rotate_counterclockwise R

# Fullscreen toggle (f like Vim file menu, but for fullscreen)
toggle_fullscreen f

# Quit (q like Vim quit)
quit q

# Additional Vim-inspired navigation
goto_top_of_page 0   # Like Vim line start
goto_bottom_of_page $  # Like Vim line end (requires config support for $)
next_page <C-f>      # Ctrl-f for forward page (Vim-like)
previous_page <C-b>  # Ctrl-b for backward page

# Visual mark mode enhancements (j/k already default for marks)
enter_visual_mark_mode m   # m for mark, but default is for set_mark; chain if needed

# Uncomment and customize more as needed from defaults
# For example, to chain commands: next_page;zoom_in <C-n>


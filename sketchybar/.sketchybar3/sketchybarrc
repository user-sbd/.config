#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Minimal Black & White theme + AeroSpace

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Black & White Palette ─────────────────────────────────────────────────────
BAR_BG="0xcc1a1a1a"          # Main bar background (semi-transparent black)
WORKSPACE_BG="0x33ffffff"    # Subtle white pill for workspaces
WORKSPACE_BORDER="0x55ffffff"
TEXT="0xfff8f8f8"            # Default white text
SUBTEXT="0xffa8a8a8"         # Secondary gray text
HIGHLIGHT="0xffffffff"       # Bright white for important items
ACCENT="0xffffffff"          # White accent for workspaces

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top \
    height=23 \
    margin=0 \
    y_offset=4 \
    corner_radius=25 \
    blur_radius=20 \
    color="$BAR_BG" \
    border_width=1 \
    border_color="0x44ffffff" \
    shadow=on \
    topmost=window \
    padding_left=12 \
    padding_right=12

# ── Global defaults ───────────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4 \
    padding_right=4 \
    icon.font="JetBrainsMonoNerdFont:Bold:13.0" \
    label.font="JetBrainsMonoNerdFont:Bold:13.0" \
    icon.color="$TEXT" \
    label.color="$TEXT" \
    icon.padding_left=6 \
    icon.padding_right=4 \
    label.padding_left=4 \
    label.padding_right=6

# ── LEFT: AeroSpace workspaces ────────────────────────────────────────────────
# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
# ── LEFT: AeroSpace workspace indicators (Circular active highlight) ─────────
sketchybar --add event aerospace_workspace_change

for sid in $(seq 1 8); do
    sketchybar --add item "space.$sid" left \
        --subscribe "space.$sid" aerospace_workspace_change \
        --set "space.$sid" \
            background.color=0x00000000 \
            background.corner_radius=12 \
            background.height=24 \
            background.drawing=off \
            label="$sid" \
            label.font="HackNerdFont-Bold:Bold:13.0" \
            label.color=0xffffffff \
            icon.drawing=off \
            padding_left=7 \
            padding_right=7 \
            click_script="aerospace workspace $sid" \
            script="$HOME/.config/sketchybar/plugins/aerospace.sh $sid"
done

# Optional subtle group background
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color=0x22ffffff \
        background.corner_radius=14 \
        background.height=32 \
        background.border_width=0

# ── LEFT: Frontmost app ───────────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off \
        label.font="HackNerdFont-Bold:Bold:13.0" \
        label.color="$SUBTEXT" \
        padding_left=10 \
        script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock (highlighted) ────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon="" \
        label.color="$HIGHLIGHT" \
        padding_left=4 \
        padding_right=4 \
        update_freq=10 \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color="$TEXT" \
        update_freq=120 \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color="$TEXT" \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ────────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠" \
        icon.font="HackNerdFont-Bold:Bold:15.0" \
        icon.color="$HIGHLIGHT" \
        label.color="$TEXT" \
        update_freq=10 \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color="$TEXT" \
        update_freq=10 \
        script="$PLUGIN_DIR/memory.sh"

sketchybar --add item secret_memory right \
    --set secret_memory \
        padding_left=8 \
        update_freq=10 \
        script="$PLUGIN_DIR/secret_memory.sh"

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
